      "id": "cac620c9-8ba1-4e8c-8b8e-1cd69d97237f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Get Guest data safely from the 'Edit Fields' node\nconst guest = $node[\"Edit Fields\"].json; \nconst interest = (guest.Interest || \"\").toLowerCase();\nconst budget = (guest.Budget || \"Medium\");\n\nreturn items.map(item => {\n  let score = 0;\n  const exp = item.json.fields;\n  const expName = (exp.Name || \"\").toLowerCase();\n  const expCategory = (exp.Category || \"\");\n\n  // LOGIC 1: Direct Category & Keyword Match\n  // Fixed \"Marin\" spelling to match your Airtable screenshot\n  if (expCategory === \"Marin\" && (interest.includes(\"boat\") || interest.includes(\"yacht\") || interest.includes(\"water\"))) {\n    score += 70;\n  } \n  else if (expCategory === \"Air\" && (interest.includes(\"helicopter\") || interest.includes(\"flight\") || interest.includes(\"sky\"))) {\n    score += 70;\n  }\n  else if (expCategory === \"Land\" && (interest.includes(\"villa\") || interest.includes(\"dinner\") || interest.includes(\"land\"))) {\n    score += 70;\n  }\n\n  // LOGIC 2: \"Unusual Request\" Fallback (e.g., Golf)\n  // If the user wants Golf/Sports, prioritize \"Land\" experiences (Villa)\n  if (interest.includes(\"golf\") || interest.includes(\"sport\")) {\n    if (expCategory === \"Land\") score += 50;\n  }\n\n  // LOGIC 3: Luxury Alignment (Budget)\n  const luxuryRank = exp[\"Luxury Rank\"] || 0; // Fixed space in \"Luxury Rank\"\n  if (budget === \"High\" && luxuryRank >= 7) score += 30;\n  if (budget === \"Ultra\" && luxuryRank >= 9) score += 50;\n\n  // Add the score to the item\n  item.json.match_score = score;\n  return item;\n});"
      },
